    "preview": "node scripts/preview.cjs",
    "preview:build": "node scripts/preview.cjs --build",
    "build:pages": "node scripts/copy-import-assets.cjs && STATIC_EXPORT=1 node scripts/next.cjs build",
    "deploy:pages": "node scripts/deploy-pages.cjs",
    "lint": "next lint",
    "lint:knip": "node scripts/knip.cjs",
    "lint:biome": "biome lint .",
    "lint:all": "pnpm lint:knip && pnpm lint:biome",
    "predev": "node scripts/copy-import-assets.cjs",
    "prebuild": "node scripts/copy-import-assets.cjs",
    "version:get": "node scripts/version.cjs get",
    "version:bump": "node scripts/version.cjs bump",
    "version:sync": "node scripts/version.cjs sync",
    "version:check": "node scripts/version.cjs check"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "@capacitor/core": "8.6.2",
