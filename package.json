{
  "name": "hishabdaily",
  "version": "1.1.5",
  "private": true,
  "description": "হিসাব — ব্যক্তিগত আয়-ব্যয়, দেনা-পাওনা ও নিয়মিত কেনাকাটার ট্র্যাকার",
  "scripts": {
    "dev": "node scripts/next.cjs dev",
