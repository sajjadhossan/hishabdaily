    "firebase": "^11.10.0",
    "html2canvas": "1.4.1",
    "jspdf": "3.0.1",
    "lucide-react": "^0.470.0",
    "next": "15.5.29",
    "papaparse": "5.7.1",
    "pdfjs-dist": "4.10.38",
